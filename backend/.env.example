# Local development configuration
DATABASE_URL="postgresql://masterbox:masterbox_dev_password@localhost:5432/masterbox"
JWT_SECRET="replace-with-a-long-random-secret"
# Comma-separated persisted admin account IDs or emails allowed to use /api/platform-admin.
PLATFORM_ADMIN_ACCOUNT_IDS=""
PLATFORM_ADMIN_EMAILS=""
# Comma-separated browser origins allowed to call the backend, including deployed subdomains.
CORS_ALLOWED_ORIGINS="https://mastertravel.masterappinc.com"
REDIS_CONNECTION="redis://localhost:6379"

# The Meta app used to connect channels. FB_APP_SECRET also signs webhook requests.
FB_APP_ID=""
FB_APP_SECRET=""
# Meta sends this back when verifying the webhook URL ({BASE_URL}/meta/webhook).
VERIFY_TOKEN=""
# Public URL of this backend. Meta must be able to reach it and it must be an allowed OAuth redirect ({BASE_URL}/meta/getToken).
BASE_URL="http://localhost:4000"
# Message attachments. Locally they go to backend/uploads; in production UPLOADS_DIR must be a mounted volume,
# otherwise attachments are turned off rather than lost on the next deploy.
# UPLOADS_DIR="/data/uploads"
# Public address files are served from (defaults to BASE_URL). Meta downloads the files agents send from here.
# FILES_PUBLIC_URL="https://api.masterbox.masterappinc.com"
# Set to true only after Meta approves the app's Human Agent permission. Messenger and Instagram replies
# 24 hours to 7 days after the customer's last message then go with the HUMAN_AGENT tag; otherwise the window is 24 hours.
META_HUMAN_AGENT_ENABLED=false
META_BASE_URL="https://graph.facebook.com"
META_API_VERSION="v23.0"
META_API_TIMEOUT_MS="15000"

# LiveKit credentials are server-only. Never expose the API secret to clients.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_TOKEN_TTL_SECONDS="300"

# Optional demo account passwords for npm run seed; random ones are generated when unset
SEED_ADMIN_PASSWORD=
SEED_TEST_PASSWORD=
