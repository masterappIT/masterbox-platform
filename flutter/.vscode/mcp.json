{
  "inputs": [
    {
      "id": "figmaApiKeyV2",
      "type": "promptString",
      "description": "Figma Personal Access Token",
      "password": true
    }
  ],
  "servers": {
    "figma-developer-mcp": {
      "type": "stdio",
      "command": "${workspaceFolder}/node_modules/.bin/figma-developer-mcp",
      "args": [
        "--figma-api-key=${input:figmaApiKeyV2}",
        "--stdio",
        "--image-dir=${workspaceFolder}/.figma-assets",
        "--no-telemetry"
      ]
    }
  }
}