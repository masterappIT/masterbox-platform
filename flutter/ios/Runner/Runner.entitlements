<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. Builds run from Xcode are signed for development, and
	     exporting for TestFlight or the App Store changes this to production
	     from the distribution profile. Production is the only environment the
	     server sends to, so iOS notifications arrive in those builds only. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
