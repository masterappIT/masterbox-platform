<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. Builds signed for development get sandbox tokens;
	     App Store and TestFlight exports switch this to production, which is
	     the only environment the MasterBox Push APNs key covers. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
